# Copy to .env (setup.bat does this automatically and generates a random JWT_SECRET)
PORT=3000
# REQUIRED for real use: long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created automatically)
DB_FILE=data/bharat.sqlite
# Token lifetime
JWT_EXPIRES=7d
# Set to your site origin when deploying publicly (e.g. https://game.example.com). * allows any.
CORS_ORIGIN=*
# Anti-abuse tuning
MAX_ROOMS=200
RANKED_GAMES_PER_DAY=5
