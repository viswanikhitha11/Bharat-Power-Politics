{
  "name": "bharat-power-politics",
  "version": "1.0.0",
  "description": "Multiplayer political strategy game for India's 543 Lok Sabha constituencies (inspired by the gameplay and presentation of 270). All parties and leaders are fictional.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "init-db": "node scripts/init-db.js",
    "test": "node --test tests/engine.test.js tests/socket.test.js",
    "simulate": "node tests/simulate.js",
    "test:ui": "node tests/ui-smoke.js",
    "baseline": "node tests/baseline.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "socket.io-client": "^4.8.1"
  }
}